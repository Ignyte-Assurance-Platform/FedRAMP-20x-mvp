# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
NODE_ENV=development
PORT=3000
# Production: the exact public https URL users open. Form actions and Google sign-in only work
# on that host (WI-016); Cloud Run's second URL for the same service is refused.
APP_URL=http://localhost:3000

# Matches compose.yaml
DATABASE_URL=postgres://maaz:maaz@localhost:5432/maaz20x

# Local-only value. Production gets a random secret from Secret Manager.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

# Dev-only sign-in without Google. Honoured only with NODE_ENV=development.
# The app refuses to start if DEV_LOGIN is set (any value) with NODE_ENV=production.
DEV_LOGIN=1
DEV_LOGIN_EMAIL=dev@ignyteplatform.com

# Google sign-in (ADR-0004) stays off until the OAuth client exists in the GCP project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=ignyteplatform.com
# Comma-separated staff allowlist seeded into `users`.
ADMIN_EMAILS=

# Document storage: local disk now, Cloud Storage once the bucket exists.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
GCS_BUCKET=
# Customer logos (WI-018): checked in the documents store, then copied to a public bucket at the
# same path. Locally a second folder; with STORAGE_DRIVER=gcs the public logos bucket (required).
LOCAL_LOGO_DIR=.data/logos
GCS_LOGO_BUCKET=
# Public base URL of the customer logos Ignyte hosts (WI-007). Generate JSON requests only
# URLs under it to check the logo is an image; empty means every logo check fails.
# Required in production: without it no customer file can carry a logo address.
LOGO_PUBLIC_BASE_URL=
# Key for the stored copy of intake links (WI-003): 32 random bytes in base64
# (`openssl rand -base64 32`). Required in production; locally it is derived from
# BETTER_AUTH_SECRET when empty.
INTAKE_LINK_KEY=
