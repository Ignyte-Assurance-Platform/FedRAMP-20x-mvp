# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Matches compose.yaml
DATABASE_URL=postgres://maaz:maaz@localhost:5432/maaz20x

# Local-only value. Production gets a random secret from Secret Manager.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

# Dev-only sign-in without Google. Honoured only with NODE_ENV=development.
# The app refuses to start if DEV_LOGIN is set (any value) with NODE_ENV=production.
DEV_LOGIN=1
DEV_LOGIN_EMAIL=dev@ignyteplatform.com

# Google sign-in (ADR-0004) stays off until the OAuth client exists in the GCP project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=ignyteplatform.com
# Comma-separated staff allowlist seeded into `users`.
ADMIN_EMAILS=

# Document storage: local disk now, Cloud Storage once the bucket exists.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
GCS_BUCKET=
